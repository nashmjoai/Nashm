<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Support Ticket</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      color: #333333;
      margin: 0;
      padding: 20px;
      background-color: #f9f9f9;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      border: 1px solid #e2e8f0;
    }
    .header {
      border-bottom: 2px solid #3b82f6;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }
    .header h2 {
      margin: 0;
      color: #1e3a8a;
      font-size: 22px;
    }
    .meta-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .meta-table td {
      padding: 8px 0;
      border-bottom: 1px solid #edf2f7;
    }
    .meta-table td.label {
      font-weight: 600;
      color: #4a5568;
      width: 120px;
    }
    .meta-table td.value {
      color: #2d3748;
    }
    .message-box {
      background-color: #f7fafc;
      border-left: 4px solid #3b82f6;
      padding: 15px;
      margin-bottom: 20px;
      white-space: pre-wrap;
      border-radius: 0 4px 4px 0;
      color: #2d3748;
    }
    .footer {
      font-size: 12px;
      color: #a0aec0;
      text-align: center;
      margin-top: 30px;
      border-top: 1px solid #edf2f7;
      padding-top: 15px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>New Support Ticket Submitted</h2>
    </div>
    <table class="meta-table">
      <tr>
        <td class="label">From Name:</td>
        <td class="value">{{userName}}</td>
      </tr>
      <tr>
        <td class="label">From Email:</td>
        <td class="value"><a href="mailto:{{userEmail}}">{{userEmail}}</a></td>
      </tr>
      <tr>
        <td class="label">User ID:</td>
        <td class="value"><code>{{userId}}</code></td>
      </tr>
      <tr>
        <td class="label">Subject:</td>
        <td class="value"><strong>{{subject}}</strong></td>
      </tr>
    </table>
    <div class="message-box">
{{message}}
    </div>
    <div class="footer">
      This is an automated email sent from {{appName}}.<br>
      &copy; {{year}} {{appName}}. All rights reserved.
    </div>
  </div>
</body>
</html>
